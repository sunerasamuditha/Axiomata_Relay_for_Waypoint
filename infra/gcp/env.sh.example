# Copy to infra/gcp/env.sh (gitignored) and fill in PROJECT_ID. Every script in this folder sources it.
export PROJECT_ID="relay-waypoint-xxxx"      # globally unique; see docs/DEPLOY_GCP.md §2
export REGION="asia-south1"                  # Mumbai: the closest region to Sri Lanka
export SERVICE="relay"                       # Cloud Run service name
export SQL_INSTANCE="relay-db"               # Cloud SQL for PostgreSQL 16 instance
export SA_NAME="relay-run"                   # runtime service account (relay-run@PROJECT_ID.iam.gserviceaccount.com)

# Size of the service (deploy.sh reads these; the defaults are what judging needs)
export CPU="2"
export MEMORY="2Gi"
export MIN_INSTANCES="1"                     # never cold-start in front of a judge
export MAX_INSTANCES="3"
