# Postgres from `docker compose up -d db` (published on 5433 so it does not clash with a local 5432)
DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5433/relay
DB_PORT_HOST=5433
APP_PORT=8080

# Session signing key. Any long random string locally; production uses Secret Manager.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
COOKIE_SECURE=false

# Create the reference data, accounts and the shared demo workspace on start-up if missing
SEED_ON_START=true

# --- optional 
# LOG_LEVEL=INFO
# SOLVER_TIME_LIMIT_S=5         # CP-SAT time limit per depot (seconds)
# EXPLAIN_BUDGET_S=4            # time for counterfactual deferral explanations (seconds)
# HEARTBEAT_DARK_S=45           # seconds without a driver heartbeat before a van shows "No signal"
# SIM_TICK_S=4                  # how often trips nobody is driving are simulated while someone watches
# ALLOW_SANDBOXES=true          # judges can start private sandbox workspaces from the sign-in page
# MAX_SANDBOXES=50
# RESET_TOKEN=                  # lets a scheduler call POST /api/demo/reset with X-Reset-Token
# RELAY_MODEL_DIR=packages/ml/models
