{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.analysis.extraPaths": ["apps/api", "packages/engine", "packages/ml"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
  },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.formatOnSave": true },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "prettier.ignorePath": ".prettierignore",
  "eslint.workingDirectories": [{ "directory": "apps/web", "changeProcessCWD": true }],
  "typescript.tsdk": "apps/web/node_modules/typescript/lib",
  "editor.rulers": [140, 160],
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "**/.ruff_cache": true },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dev-dist": true,
    ".venv": true,
    "data/private": true,
    "pnpm-lock.yaml": true,
    "uv.lock": true
  },
  "sqltools.connections": [
    {
      "name": "Relay (local, make dev)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5433,
      "database": "relay",
      "username": "relay",
      "password": "relay"
    }
  ],
  "playwright.reuseBrowser": false
}
