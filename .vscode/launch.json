{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: uvicorn (debug, :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["relay_api.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Engine: check-plan",
      "type": "debugpy",
      "request": "launch",
      "module": "relay_api.check_plan",
      "args": ["--policy", "balanced"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Web: Chrome on :5173",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ]
}
